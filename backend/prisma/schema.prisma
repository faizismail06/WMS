datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  ADMIN_GUDANG
  SUPERVISOR
  ADMIN_SISTEM
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  IN
  OUT
}

enum OpnameStatus {
  DRAFT
  COUNTING
  WAITING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

enum AdjustmentReason {
  DAMAGED
  EXPIRED
  LOST
  FOUND
  OTHER
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  fullName  String
  roleId    String
  role      Role       @relation(fields: [roleId], references: [id])
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  transactions    StockTransaction[]
  adjustments     StockAdjustment[]
  opnamesCreated  StockOpname[]       @relation("OpnameCreator")
  opnamesVerified StockOpname[]       @relation("OpnameVerifier")
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@map("users")
}

model Category {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)
  products    Product[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("categories")
}

model Supplier {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  contactPerson String
  phone         String
  email         String
  address       String
  status        ProductStatus      @default(ACTIVE)
  products      Product[]
  transactions  StockTransaction[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("suppliers")
}

model Product {
  id           String        @id @default(uuid())
  sku          String        @unique
  name         String
  description  String?
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  unit         String
  supplierId   String
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  price        Decimal       @db.Decimal(12, 2)
  stock        Int           @default(0)
  minStock     Int           @default(5)
  rackLocation String
  status       ProductStatus @default(ACTIVE)

  transactionItems StockTransactionItem[]
  adjustments      StockAdjustment[]
  opnameItems      StockOpnameItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model StockTransaction {
  id            String          @id @default(uuid())
  transactionNo String          @unique
  type          TransactionType
  date          DateTime        @default(now())
  supplierId    String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  destination   String?
  notes         String?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])

  items StockTransactionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_transactions")
}

model StockTransactionItem {
  id            String           @id @default(uuid())
  transactionId String
  transaction   StockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Decimal          @default(0) @db.Decimal(12, 2)
  totalPrice    Decimal          @default(0) @db.Decimal(12, 2)
  stockBefore   Int
  stockAfter    Int

  @@map("stock_transaction_items")
}

model StockAdjustment {
  id           String           @id @default(uuid())
  adjustmentNo String           @unique
  productId    String
  product      Product          @relation(fields: [productId], references: [id])
  systemStock  Int
  actualStock  Int
  difference   Int
  reason       AdjustmentReason
  notes        String?
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())

  @@map("stock_adjustments")
}

model StockOpname {
  id              String       @id @default(uuid())
  opnameNo        String       @unique
  title           String
  period          String
  status          OpnameStatus @default(DRAFT)
  notes           String?
  rejectionReason String?
  createdById     String
  createdBy       User         @relation("OpnameCreator", fields: [createdById], references: [id])
  verifiedById    String?
  verifiedBy      User?        @relation("OpnameVerifier", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?

  items StockOpnameItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_opnames")
}

model StockOpnameItem {
  id            String      @id @default(uuid())
  opnameId      String
  opname        StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  systemStock   Int
  physicalStock Int         @default(0)
  difference    Int         @default(0)
  notes         String?

  @@map("stock_opname_items")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  recordId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
